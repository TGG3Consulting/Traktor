# Настройки локального стека. Скопируйте в .env и при желании поменяйте пароли.
# Файл .env в git не попадает (правило 15: секреты не в репозитории).
#
# ВАЖНО: это значения для разработки на своём компьютере. При переезде в облако
# те же переменные приходят из Secret Manager, код не меняется.

POSTGRES_PASSWORD=traktor-local
S3_ACCESS_KEY=traktor
S3_SECRET_KEY=traktor-local-secret

# Ключ шифрования телефонов в базе (pgcrypto). В проде — из Secret Manager.
PHONE_ENC_KEY=traktor-local-phone-key

# Фиксированный код входа, пока SMS-провайдер на паузе.
# В боевой конфигурации переменная не задаётся и код становится случайным.
OTP_STATIC_CODE=000000
